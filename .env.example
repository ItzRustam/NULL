# Cloud Models (Gemini 3.5 Flash-Lite & Gemini 3.1 Flash-Lite)
# Required for NULL, Alex, and CoreX, Techno & Tool Security
GOOGLE_API_KEY="api key"
GROQ_API_KEY="key"

# Techno API Caller (RSRoute Gateway)
RSROUTE_BASE_URL=http://0.0.0.0:8000/

# Use Your Best Model for it.
NULL_MODEL="gemini-3.5-flash-lite"

# Alex & CoreX - Changeable in future, 120B+ recommanded
ALEX_MODEL="gemini-3.1-flash-lite"
COREX_MODEL="gemini-3.1-flash-lite"

# Techno & Cod - Both Changed to Cloud
TECHNO_MODEL="gemma-4-26b-a4b-it"
# Cod is Multi-model
TOOl_SECURITY="qwen/qwen3.8-27b" # from groq for run_python_code system security guard John.

# Cod is Free Multi-Model sub-agent with Groq
# Hard Task -> OSS-GPT:120B and if fallback then 
# Easy Task/Modrate Task -> gemma-4-31b-it

# Max Tool calling
MAX_TOOL_CALLS=12 # Each Agent can call maximum 12 Tools